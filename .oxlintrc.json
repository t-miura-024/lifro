{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-console": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "no-throw-literal": "error",
    "no-duplicate-imports": [
      "error",
      {
        "includeExports": true
      }
    ],
    "object-shorthand": ["error", "always"],
    "no-param-reassign": [
      "error",
      {
        "props": true
      }
    ],
    "curly": ["error", "all"],
    "id-denylist": ["error", "data", "info", "manager", "handler", "utils", "helper", "common"],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 180,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "max-depth": ["error", 6],
    "max-nested-callbacks": ["error", 3],
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "oxc/no-barrel-file": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": "error",
    "typescript/consistent-type-assertions": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-misused-promises": "off",
    "typescript/require-await": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-return": "off"
  },
  "overrides": [
    {
      "files": ["src/server/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "@cloudflare/*",
              "wrangler",
              "@/server/application",
              "@/server/application/**",
              "@/server/infrastructure",
              "@/server/infrastructure/**",
              "@/server/orpc",
              "@/server/orpc/**",
              "@/server/api",
              "@/server/api/**",
              "@/components",
              "@/components/**",
              "@/routes",
              "@/routes/**",
              "**/application/**",
              "**/infrastructure/**",
              "**/orpc/**",
              "**/api/**",
              "**/components/**",
              "**/routes/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/server/infrastructure",
              "@/server/infrastructure/**",
              "@/server/orpc",
              "@/server/orpc/**",
              "@/server/api",
              "@/server/api/**",
              "@/components",
              "@/components/**",
              "@/routes",
              "@/routes/**",
              "**/infrastructure/**",
              "**/orpc/**",
              "**/api/**",
              "**/components/**",
              "**/routes/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/server/orpc",
              "@/server/orpc/**",
              "@/server/api",
              "@/server/api/**",
              "@/components",
              "@/components/**",
              "@/routes",
              "@/routes/**",
              "**/orpc/**",
              "**/api/**",
              "**/components/**",
              "**/routes/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/orpc/**", "src/routes/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/server/infrastructure",
              "@/server/infrastructure/**",
              "@/components",
              "@/components/**",
              "@/routes",
              "@/routes/**",
              "**/infrastructure/**",
              "**/components/**",
              "**/routes/**"
            ]
          }
        ],
        "no-console": "warn"
      }
    },
    {
      "files": ["src/components/**", "src/routes/**", "src/hooks/**", "src/lib/**", "src/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@/server/infrastructure", "@/server/infrastructure/**", "@/server/orpc", "@/server/orpc/**", "@/server/api", "@/server/api/**", "**/infrastructure/**", "**/orpc/**", "**/api/**"]
          }
        ]
      }
    },
    {
      "files": ["src/server/shared/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 400
          }
        ]
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "typescript/no-extraneous-class": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["vite.config.mts", "vite.config.ts", "playwright.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".wrangler/",
    ".next/",
    "coverage/",
    "tmp/",
    ".tanstack/",
    ".hunk/",
    "drizzle/",
    "public/"
  ]
}